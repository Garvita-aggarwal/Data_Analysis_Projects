   "source": [
    "import sqlite3\n",
    "\n",
    "conn = sqlite3.connect(\"../database/telecom.db\")\n",
    "\n",
    "cursor = conn.cursor()\n",
    "\n",
    "query = \"\"\"\n",
    "SELECT COUNT(*) AS total_customers\n",
    "FROM telecom;\n",
    "\"\"\"\n",
    "\n",
    "cursor.execute(query)\n",
    "\n",
    "result = cursor.fetchall()\n",
    "\n",
    "print(result)\n",
    "\n",
    "conn.close()"
   ]
